# Google Gemini API keys (comma-separated for key rotation)
GOOGLE_API_KEYS=your-google-api-key-1,your-google-api-key-2

# Fly.io app URL (set after deploying: https://<your-app-name>.fly.dev)
HOST_URL=https://asana-yoga-chatbot.fly.dev

# Optional: image generation service
SSLIP_BASE_URL=https://your-sslip-server.io
SSLIP_USER_ID=your-user-id
